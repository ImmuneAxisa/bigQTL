// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/rocker-org/devcontainer-templates/tree/main/src/r2u
{
	"name": "R (r2u and bspm configured)",
	// Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
	"image": "mcr.microsoft.com/devcontainers/base:noble",

	// Features to add to the dev container. More info: https://containers.dev/features.
	"features": {
		// A Feature to configure R on Ubuntu. More info: https://github.com/rocker-org/devcontainer-features/tree/main/src/r-apt.
		"ghcr.io/rocker-org/devcontainer-features/r-apt:0": {
			"vscodeRSupport": "full",
			"installDevTools": true,
			"installRMarkdown": true,
			"installRadian": true,
			"installVscDebugger": true,
			"installBspm": true,
		},
		// Quarto CLI — pinned to the version used during development.
		// Check https://github.com/quarto-dev/quarto-cli/releases for newer versions.
		"ghcr.io/rocker-org/devcontainer-features/quarto-cli:1": {
			"version": "1.7.32"
		},
		"ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {}
	},

	// Forward the Quarto preview server to the host browser.
	"forwardPorts": [4321],
	"portsAttributes": {
		"4321": { "label": "Quarto preview", "onAutoForward": "notify" }
	},

	// Install R packages after the container is created.
	// Uses r2u binary packages (fast, no compilation).
	// bigstatsr/bigsnpr/reticulate/nlshrink are bigQTL's Imports/Suggests
	// (file-backed matrices, eigenMT shrinkage, Python interop for the
	// eigenMT_validation vignette).
	"postCreateCommand": "R -q -e 'install.packages(c(\"arrow\", \"duckdb\", \"dplyr\", \"jsonlite\", \"bigstatsr\", \"bigsnpr\", \"reticulate\", \"nlshrink\"))'",

	// Configure tool-specific properties.
	"customizations": {
		// Settings for VS Code.
		"vscode": {
			"extensions": [
				"RDebugger.r-debugger",
				"quarto.quarto",
				"anthropic.claude-code"
			],
			"settings": {
				"r.rterm.linux": "/usr/local/bin/radian",
				"r.bracketedPaste": true,
				"r.plot.useHttpgd": true
			}
		}
	},

	// Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
	// "remoteUser": "root"
}
